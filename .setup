# install homebrew
/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/master/install.sh)"

# install common dev tools
./.brew

# install Go
./.go

# install rvm:
\curl -sSL https://get.rvm.io | bash

# install nvm
curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.5/install.sh | bash
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

# Install dotfiles
rsync -av ./home/ ~/

# Install claude-projects (private repo, needs gh auth; gh comes from .brew) and link ~/.claude into it
gh auth status >/dev/null 2>&1 || gh auth login
mkdir -p ~/Code
[ -d ~/Code/claude-projects ] || gh repo clone jfeldstein/claude-projects ~/Code/claude-projects -- --recurse-submodules
bash ~/Code/claude-projects/scripts/link-dot-claude-into-home.sh

# Install the Hermes + Home Assistant setup (private repo, needs gh auth); fill the secret files it creates afterwards
[ -d ~/Code/hermes-setup ] || gh repo clone jfeldstein/hermes-setup ~/Code/hermes-setup
bash ~/Code/hermes-setup/bootstrap.sh

# Init VS Code settings
mv home/.vscode/settings.json ~/Library/Application\ Support/Code/User/

# setup osx preferences:
./.osx

# log out, back in again
osascript -e 'tell app "System Events" to log out'

echo ""
echo ""
echo "Please close terminal and reopen if you need it."
